# --- Telegram ---
TELEGRAM_BOT_TOKEN=put_your_botfather_token_here
# Comma-separated Telegram numeric IDs allowed to use the bot. Empty = allow all (NOT recommended).
# Get your ID from @userinfobot
ALLOWED_USER_IDS=
# Chats that receive opencode event pushes (session done, permission needed). Usually same as above.
TELEGRAM_NOTIFY_CHAT_IDS=

# --- OpenCode ---
# Project folder OpenCode works in. Gateway chdir's here before starting the server.
WORK_DIR=D:\
# Optional: attach to an already-running `opencode serve` / `opencode web` instead of starting one.
# Example: http://127.0.0.1:4096
OPENCODE_SERVER_URL=
OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=4096
# Optional defaults in provider/model format, e.g. anthropic/claude-sonnet-4-5
OPENCODE_MODEL=
OPENCODE_AGENT=
# Raw /cli passthrough (full CLI parity). Set false to disable.
CLI_ENABLED=true
# Restricted networks only: pin api.telegram.org to a reachable DC IP (no admin needed).
# Find a working IP by testing TCP 443 to Telegram DCs. Empty = normal DNS.
# NOTE: `setup` finds this automatically — you rarely set it by hand.
TELEGRAM_API_IP=
# Restricted networks only: proxy for Telegram traffic. Empty = direct.
HTTPS_PROXY=
# Power users only: route ALL Bot API traffic through your own reverse proxy
# (generic — any proxy you trust, no vendor needed). Empty = api.telegram.org.
# The setup wizard uses this automatically if you configured one before.
TELEGRAM_API_ROOT=
