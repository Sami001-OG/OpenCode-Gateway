# --- Telegram ---
TELEGRAM_BOT_TOKEN=put_your_botfather_token_here
# Comma-separated Telegram numeric IDs allowed to use the bot. Empty = allow all (NOT recommended).
# Get your ID from @userinfobot
ALLOWED_USER_IDS=
# DANGER: only set ALLOW_OPEN_BOT=true if you intentionally want ANY Telegram user
# to be able to run code on this machine (e.g. a short public demo). Default: refused.
ALLOW_OPEN_BOT=false
# Chats that receive opencode event pushes (session done, permission needed). Usually same as above.
TELEGRAM_NOTIFY_CHAT_IDS=

# --- OpenCode ---
# Project folder OpenCode works in (absolute path). Gateway chdir's here before starting the server.
# Windows example: C:\Users\you\project   |   macOS/Linux example: /home/you/project
WORK_DIR=
# Optional: attach to an already-running `opencode serve` / `opencode web` instead of starting one.
# Example: http://127.0.0.1:4096
OPENCODE_SERVER_URL=
# Only for attaching to an OpenCode v2 server: the password printed by
# `opencode serve` (v2 protects /api with HTTP Basic auth). Leave empty when the
# gateway starts the server itself — it reads the password from the startup log.
OPENCODE_SERVER_PASSWORD=
OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=4096
# Optional defaults in provider/model format, e.g. anthropic/claude-sonnet-4-5
OPENCODE_MODEL=
OPENCODE_AGENT=
# Raw /cli passthrough (full CLI parity). Set false to disable.
CLI_ENABLED=true
# Restricted networks only: pin api.telegram.org to a reachable DC IP (no admin needed).
# Find a working IP by testing TCP 443 to Telegram DCs. Empty = normal DNS.
# NOTE: `setup` finds this automatically — you rarely set it by hand.
TELEGRAM_API_IP=
# Restricted networks only: proxy for Telegram traffic. Empty = direct.
HTTPS_PROXY=
# Power users only: route ALL Bot API traffic through your own reverse proxy
# (generic — any proxy you trust, no vendor needed). Empty = api.telegram.org.
# The setup wizard uses this automatically if you configured one before.
TELEGRAM_API_ROOT=

# --- Streaming / inline / groups ---
# Native streaming drafts + Stop button (default on). Set false to use edit-spinner only.
TELEGRAM_STREAM=true
# Optional cheap model + timeout for @bot inline-mode answers.
INLINE_MODEL=
INLINE_TIMEOUT_MS=8000
# Group chats with @mention activation (default on). Set false to ignore groups.
GROUPS_ENABLED=true
# Comma-separated tool commands to disable (e.g. bash,shell,cli).
TOOL_POLICY_DENY=

# --- Webhook mode (optional alternative to long polling) ---
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_HOST=0.0.0.0
TELEGRAM_WEBHOOK_PORT=8443
TELEGRAM_WEBHOOK_SECRET=

# --- Mini App / automation ---
TELEGRAM_MINIAPP_URL=
# Snapshot workspace files before every plain-chat prompt (opt-in).
CHECKPOINT_ON_PROMPT=false
